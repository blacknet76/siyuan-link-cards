{
  "name": "siyuan-link-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rich link cards and native YouTube embeds for SiYuan.",
  "license": "MIT",
  "author": "blacknet76",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests webpack.config.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "dev": "webpack --mode development --watch",
    "build:dev": "webpack --mode development",
    "build": "webpack --mode production",
    "package": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "28.0.1",
    "@types/node": "26.0.0",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "dprint": "0.58.0",
    "esbuild-loader": "4.5.0",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "jsdom": "30.1.1",
    "mini-css-extract-plugin": "2.10.2",
    "siyuan": "1.2.9",
    "typescript": "6.0.3",
    "webpack": "5.107.2",
    "webpack-cli": "7.0.3",
    "zip-webpack-plugin": "4.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blacknet76/siyuan-link-cards.git"
  }
}
